# Copy to .env and fill in from your Spotify app:
#   https://developer.spotify.com/dashboard  ->  Create app
# In the app settings, add this exact Redirect URI: http://127.0.0.1:8888/callback
SPOTIPY_CLIENT_ID=your-client-id
SPOTIPY_CLIENT_SECRET=your-client-secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: a Discogs personal access token enables the Discogs genre source.
# Create one at https://www.discogs.com/settings/developers . Without it, the
# discogs provider is skipped and genres come from MusicBrainz/Spotify.
DISCOGS_TOKEN=
